# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

/.idea

# Material de referência pesado (PDF de branding ~135MB) — não versionar
/contexts/
# Pasta de tarefas local
/tasks/
# Originais de câmera das fotos e vídeos da faixa "no mundo real" (~209MB).
# O site consome as versões web em /img/real/ — estas ficam só na máquina.
/img/modobimreal/
# Dependencias Node (tooling de deploy do Apps Script — task 20)
/node_modules/

# Credenciais do clasp, se o npm as gerar localmente. Nunca versionar.
.clasprc.json

# Originais de câmera nunca vão para o ar — só as derivadas de img/opt/ (task 21 · T8).
# img/day.jpg (24 MB, 4000x6000) e img/joe.jpg (20 MB, 3875x5813) estão na árvore, não
# rastreados: um `git add .` distraído publicaria 44 MB, e o que entra no histórico do
# git fica lá para sempre, no clone de todo mundo. As fotos da seção "quem somos" que o
# site usa continuam sendo img/dayana.jpg e img/joene.jpg.
/img/*-original.*
/img/day.jpg
/img/joe.jpg

# Artefatos da suíte de testes (task 19). test-results/ guarda protocolos e
# e-mails de QA da rodada @live — registro operacional, não artefato de repo.
/test-results/
/playwright-report/
/coverage/
